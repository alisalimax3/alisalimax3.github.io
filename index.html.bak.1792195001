<!doctype html><html lang="ar" dir="rtl"><head>
<script src="/killsw.js"></script>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CineHub 3099 — أفلام مجانية + اربح واسحب للكريمي</title>
<meta name="description" content="شاهد أفلامًا مجانية قانونية، اجمع مكافآت يومية، انشر روابط وصورًا، واسحب أرباحك إلى بنك الكريمي من $5. أرقام حقيقية من واجهات الشبكات والبلوكتشين.">
<meta name="theme-color" content="#070b14">
<link rel="manifest" href="/manifest.json">
<meta property="og:type" content="website"><meta property="og:site_name" content="CineHub 3099">
<meta property="og:locale" content="ar_YE"><meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" href="/rss.xml">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#070b14;--card:#0f1626;--line:#1d2a44;--tx:#e9f4ff;--dim:#8ba2c0;--c1:#22d3ee;--c2:#a78bfa;--ok:#22c55e;--w:#fbbf24;--b:#f87171}
html{scroll-behavior:smooth}
body{background:radial-gradient(1200px 600px at 50% -15%,#132a44,#070b14 60%) fixed;color:var(--tx);
 font:15px/1.75 system-ui,"Segoe UI",Tahoma,sans-serif;-webkit-tap-highlight-color:transparent;padding-bottom:70px}
a{color:var(--c1);text-decoration:none}
.wrap{max-width:1040px;margin:0 auto;padding:0 14px}
header{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:#070b14cc;border-bottom:1px solid var(--line)}
.hd{display:flex;align-items:center;gap:10px;padding:10px 0;flex-wrap:wrap}
.logo{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--c1),var(--c2));display:grid;place-items:center;font-weight:900;color:#04121a;font-size:17px;cursor:pointer}
.brand b{font-size:15px}.brand span{display:block;color:var(--dim);font-size:11px}
nav{margin-inline-start:auto;display:flex;gap:6px;flex-wrap:wrap}
nav a{font-size:12.5px;border:1px solid var(--line);padding:6px 11px;border-radius:9px;color:var(--tx);transition:.18s}
nav a:hover{border-color:var(--c1);background:#0f1626;transform:translateY(-1px)}
.hero{position:relative;overflow:hidden;border-radius:20px;padding:30px 18px;margin:16px 0;text-align:center;border:1px solid #223252;
 background:linear-gradient(135deg,#0e1c33,#141a30 55%,#1b1430)}
.hero:before{content:"";position:absolute;inset:-45%;background:conic-gradient(from 0deg,#22d3ee44,#a78bfa44,#22c55e44,#22d3ee44);animation:spin 20s linear infinite;filter:blur(46px);opacity:.55}
@keyframes spin{to{transform:rotate(360deg)}}
.hero>*{position:relative}
.hero h1{font-size:clamp(20px,4.4vw,32px);line-height:1.35;margin-bottom:8px;
 background:linear-gradient(90deg,#22d3ee,#a78bfa,#22c55e);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:#a9c0da;font-size:13.5px;max-width:620px;margin:0 auto 16px}
.cta{display:inline-block;background:linear-gradient(135deg,#22c55e,#22d3ee);color:#04121a;font-weight:900;
 border-radius:12px;padding:12px 22px;margin:4px;box-shadow:0 10px 30px #22c55e30}
.cta.alt{background:linear-gradient(135deg,#a78bfa,#22d3ee)}
.live{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px}
.live span{background:#0b1220cc;border:1px solid #223252;border-radius:999px;padding:6px 13px;font-size:11.5px;color:#bcd3e8}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ok);margin-inline-end:5px;animation:p 1.6s infinite}
@keyframes p{50%{opacity:.35}}
.grid{display:grid;gap:11px;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));margin:14px 0}
.card{background:linear-gradient(180deg,#111a2c,#0d1424);border:1px solid var(--line);border-radius:15px;padding:14px;transition:.2s}
.card:hover{transform:translateY(-3px);border-color:#2b3f66;box-shadow:0 12px 30px #0006}
.card .ic{font-size:22px}.card b{display:block;margin:6px 0 3px;font-size:14.5px}
.card p{color:var(--dim);font-size:12.5px}
h2{font-size:16px;margin:22px 0 8px;display:flex;align-items:center;gap:8px}
h2:before{content:"";width:4px;height:15px;border-radius:2px;background:linear-gradient(var(--c1),var(--c2))}
.k{color:var(--dim);font-size:11.5px}.v{font-size:22px;font-weight:800}
.pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;border:1px solid}
.ok{color:var(--ok);border-color:#22c55e55;background:#22c55e11}
.w{color:var(--w);border-color:#fbbf2455;background:#fbbf2411}
table{width:100%;border-collapse:collapse;font-size:12.5px}
th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:right}th{color:var(--dim)}
input,select{width:100%;padding:9px 11px;border-radius:10px;border:1px solid var(--line);background:#0b1220;color:var(--tx);font:inherit}
button{background:linear-gradient(135deg,#22c55e,#22d3ee);color:#04121a;border:0;border-radius:10px;padding:10px 15px;font-weight:800;cursor:pointer}
.foot{color:var(--dim);font-size:12px;text-align:center;padding:22px 0;border-top:1px solid var(--line);margin-top:24px}
.owner-only{display:none!important}
html[data-owner="1"] .owner-only{display:inline-block!important}
.bn{display:flex;gap:9px;align-items:center;background:#0b1220;border:1px solid var(--line);border-radius:12px;padding:9px 11px;margin:7px 0}
.bn b{font-size:13px}
</style></head>
<body>
<header><div class="wrap hd">
 <div class="logo" title="5 نقرات = لوحة المالك">▶</div>
 <div class="brand"><b>CineHub 3099</b><span>أفلام مجانية · أرباح حقيقية · سحب للكريمي</span></div>
 <nav>
  <a href="/library.html">المكتبة</a><a href="/cinema.html">سينما</a><a href="/watch.html">شاهد واقبض</a>
  <a href="/img.html">انشر صورة</a><a href="/rewards.html">مكافآت</a>
  <a href="/apply.html" class="owner-only">سجّل واقبض</a>
  <a href="/withdraw.html">اسحب</a>
 </nav>
</div></header>
<div class="wrap">
 <section class="hero">
  <h1>شاهد مجانًا · اجمع أرباحًا · اسحب إلى بنك الكريمي</h1>
  <p>أفلام ملك عام قانونية تُشاهد داخل التطبيق، مكافآت يومية وعجلة حظ، بوابات استطلاعات تدفع، ونشر روابط وصور تُدرّ عليك. كل رقم مقروء من واجهات الشبكات ومن البلوكتشين — لا تقديرات مُجمّلة.</p>
  <a class="cta" href="/start.html">ابدأ واربح ←</a>
  <a class="cta alt" href="/cinema.html">شاهد فيلمًا الآن</a>
  <div class="live">
   <span><span class="dot"></span>المحرّك: <b id="h-hb">…</b></span>
   <span>إيراد حقيقي 30 يوم: <b id="h-rev">$0.000000</b></span>
   <span>زيارات عالمية: <b data-gviews>—</b></span>
   <span>قيود موثّقة: <b id="h-led">0</b></span>
  </div>
 </section>
 <div class="grid">
  <a class="card" href="/library.html"><div class="ic">🎬</div><b>المكتبة الضخمة</b><p>مئات الأفلام القانونية تُشاهد داخليًا</p></a>
  <a class="card" href="/watch.html"><div class="ic">▶️</div><b>شاهد واقبض</b><p>إعلان 15 ثانية = ربح فوري لرصيدك</p></a>
  <a class="card" href="/img.html"><div class="ic">🖼️</div><b>انشر صورة</b><p>رابط واحد، وكل مشاهدة ترفع رصيدك</p></a>
  <a class="card" href="/rewards.html"><div class="ic">🎁</div><b>مكافآت يومية</b><p>حضور بسلاسل · عجلة · أكواد هدايا</p></a>
  <a class="card" href="/surveys.html"><div class="ic">📊</div><b>استطلاعات تدفع</b><p>بوابات حقيقية بـ$0.2–3 للاستطلاع</p></a>
  <a class="card" href="/withdraw.html"><div class="ic">🏦</div><b>اسحب للكريمي</b><p>من $5 · الاسم والحساب والهاتف</p></a>
 </div>
 <h2>حالة التشغيل — من الملفات الفعلية</h2>
 <div class="card" id="status">… يُقرأ</div>
 <h2>الأرقام الحقيقية</h2>
 <div class="grid">
  <div class="card"><div class="k">إيراد الشبكات 30 يوم</div><div class="v" id="rev">$0.000000</div></div>
  <div class="card"><div class="k">ظهور حقيقي</div><div class="v" id="imp">0</div></div>
  <div class="card"><div class="k">نقرات</div><div class="v" id="clk">0</div></div>
  <div class="card"><div class="k">رصيدك القابل للسحب</div><div class="v" id="bal">$0.0000</div></div>
 </div>
 <h2>أفلام مقترحة الآن</h2>
 <div class="grid" id="films">…</div>
 <h2>الشبكات وأدنى سحب</h2>
 <div class="card" style="padding:0;overflow:auto">
  <table><thead><tr><th>الشبكة</th><th>مفتاح</th><th>أدنى سحب</th><th>الدفع</th></tr></thead><tbody id="nets"></tbody></table>
 </div>
 <h2>المسار إلى حسابك في الكريمي</h2>
 <div class="card"><pre style="direction:ltr;text-align:left;background:#0b1220;border:1px solid var(--line);border-radius:10px;padding:11px;overflow:auto;font-size:11.5px">الشبكة (Adsterra/Monetag/Linkvertise)
   |  سحب USDT (TRC20)  أو  Wire
محفظة (Binance / Trust Wallet)
   |  P2P أو صرافة محلية
بنك الكريمي — حسابك (ريال يمني)
SWIFT: KBMFYESAXXX</pre>
  <div class="k" id="kuraimi">…</div></div>
 <div class="foot">CineHub 3099 · <span id="stamp">—</span> · <a href="https://alkazmybwhwr-dot.github.io">alkazmybwhwr-dot.github.io</a></div>
</div>
<script src="/ledger.js" defer></script>
<script src="/authtoken.js" defer></script>
<script src="/beacon.js" defer></script>
<script src="/linkgo.js" defer></script>
<script src="/ads.js" defer></script>
<script src="/owner.js" defer></script>
<script src="/comments.js" defer></script>
<script>
(function(){
 function q(s){return document.querySelector(s)},N=function(v){return isFinite(+v)?+v:0};
 function paint(){ if(q("#bal"))q("#bal").textContent='$'+(window.CHLedger?CHLedger.balance():0).toFixed(4); }
 paint();setInterval(paint,2000);
 function fill(id,txt){var e=q(id);if(e&&(!e.textContent||e.textContent==='…'||e.textContent==='… يُقرأ'))e.textContent=txt}
 setTimeout(function(){
  fill("#status","… تعذّر قراءة الحالة"); fill("#films","… تعذّر قراءة الأفلام");
  fill("#stamp",new Date().toISOString().slice(0,10));
 },3500);
 Promise.all([
  fetch('/revenue.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/heartbeat.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/ledger-index.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/networks.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/ads-config.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/data/archive.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/kuraimi.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}}),
  fetch('/owner.json?t='+Date.now()).then(function(r){return r.json()}).catch(function(){return{}})
 ]).then(function(a){
  var rev=a[0]||{},hb=a[1]||{},li=a[2]||{},net=a[3]||{},cfg=a[4]||{},ar=a[5]||{},ku=a[6]||{},own=a[7]||{};
  q("#h-rev").textContent='$'+Number(rev.revenue||0).toFixed(6);
  q("#h-hb").textContent=hb.t?hb.t.slice(5,16)+'Z':'بانتظار النبضة';
  q("#h-led").textContent=li.entries||0;
  q("#rev").textContent='$'+Number(rev.revenue||0).toFixed(6);
  q("#imp").textContent=Number(rev.impressions||0).toLocaleString('en');
  q("#clk").textContent=Number(rev.clicks||0).toLocaleString('en');
  var B=cfg.banners||{},keys=0;Object.keys(B).forEach(function(x){if(B[x]&&B[x].key)keys++});
  var mk=(net.networks||[]).filter(function(x){return Object.keys(x.keys||{}).some(function(y){return x.keys[y]})});
  var rows=[["حالة المحرّك",cfg.enabled?"ok":"w",cfg.enabled?"مُفعّل":"موقوف"],
   ["خانات مربوطة",keys?"ok":"w",keys?keys+" خانة — ظهور حقيقي":"لا مفاتيح ⇒ $0.00 حقيقةً"],
   ["شبكات لها مفاتيح",mk.length?"ok":"w",mk.length?mk.map(function(x){return x.name}).join(" · "):"سجّل في Adsterra واملأ keys.env"],
   ["سلسلة السجل",li.broken?"b":"ok",li.broken?li.broken+" مكسور":"سليمة ✓"],
   ["هوية الكابتشا",window.CHAuth&&CHAuth.valid()?"ok":"w",window.CHAuth&&CHAuth.valid()?CHAuth.token().id:"غير مُفعّلة — /gate.html"]];
  q("#status").innerHTML=rows.map(function(x){return '<div class="bn"><span class="pill '+x[1]+'">'+x[2]+'</span><b>'+x[0]+'</b></div>'}).join("");
  var films=[];Object.keys(ar.cols||{}).forEach(function(k){(ar.cols[k]||[]).slice(0,4).forEach(function(f){films.push(f)})});
  films=films.slice(0,8);
  q("#films").innerHTML=films.map(function(f){
   return '<a class="card" href="/cinema.html#'+f.id+'"><b>'+String(f.t).slice(0,44)+'</b><p>'+(f.y||'')+' · '+(f.dl||0).toLocaleString('en')+' تحميل</p></a>'}).join("")||'<div class="card">…</div>';
  q("#nets").innerHTML=(net.networks||[]).filter(function(x){return x.enabled||Object.keys(x.keys||{}).some(function(y){return x.keys[y]})}).slice(0,12).map(function(x){
   var has=Object.keys(x.keys||{}).some(function(y){return x.keys[y]});
   return '<tr><td><b>'+x.name+'</b></td><td><span class="pill '+(has?'ok':'w')+'">'+(has?'مربوط':'—')+'</span></td><td>$'+(x.min_payout||0)+'</td><td>'+((x.methods||[]).join(' · ')||'—')+'</td></tr>'}).join("")||'<tr><td colspan=4>لا شبكات مُفعّلة بعد</td></tr>';
  q("#kuraimi").innerHTML=own.kuraimi_name?('يُحوَّل إلى: <b>'+own.kuraimi_name+'</b> — '+(own.kuraimi_account||'')+' — '+(own.kuraimi_phone||'')):'<span class="w">⚠ لم تُضبط بيانات الكريمي — املأ keys.env</span>';
  q("#stamp").textContent=new Date().toISOString().slice(0,10);
 });
})();
</script>
<script src="/boot.js" defer></script>
</body></html>
